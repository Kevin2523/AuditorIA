      "id": "a0000001-0000-0000-0000-000000000003",
      "name": "Get Hosts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -1000,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Get queries from original webhook body\nconst queries = $('Webhook Batch').first().json.body.queries;\nconst descriptions = $('Webhook Batch').first().json.body.descriptions || [];\nconst hostIds = $input.first().json.hosts.map(h => h.id);\n\n// Limit to 4 queries max\nconst limitedQueries = queries.slice(0, 4);\nconst limitedDescs = descriptions.slice(0, 4);\n\nreturn limitedQueries.map((query, index) => ({\n  json: {\n    query: query,\n    index: index,\n    description: limitedDescs[index] || 'Query ' + (index + 1),\n    hostIds: hostIds\n  }\n}));"
      },
      "id": "a0000001-0000-0000-0000-000000000097",
      "name": "Prepare Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const token = $('Store Token').first().json.fleet_token;\nconst hostIds = $('Get Hosts').first().json.hosts.map(h => h.id);\nconst items = $input.all();\nconst reportIds = [1, 7, 8, 9];\n\nconst promises = items.map((item, index) => {\n    const reportId = reportIds[index % reportIds.length];\n    const query = item.json.query;\n    const desc = item.json.description || 'Query ' + (index + 1);\n    \n    return (async () => {\n        try {\n            await this.helpers.httpRequest({\n                method: 'PATCH',\n                url: `https://host.docker.internal:1337/api/v1/fleet/reports/${reportId}`,\n                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },\n                body: { query: query },\n                json: true\n            });\n            \n            const result = await this.helpers.httpRequest({\n                method: 'POST',\n                url: `https://host.docker.internal:1337/api/v1/fleet/reports/${reportId}/run`,\n                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },\n                body: { query_ids: [reportId], host_ids: hostIds },\n                json: true\n            });\n            \n            return { description: desc, query: query, result: result, status: 'success' };\n        } catch (error) {\n            return { description: desc, query: query, error: error.message, status: 'error' };\n        }\n    })();\n});\n\n// Promise.allSettled: no falla si una query falla\nconst results = await Promise.allSettled(promises);\nreturn results.map(r => r.value || r.reason);"
      },
      "id": "a0000001-0000-0000-0000-000000000050",
      "name": "Run All Parallel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "results",
        "include": "allFieldsExcept",
        "fieldsToInclude": {
